# BOB_ROBO_CONVO — environment variables
# Copy to .env and fill in before running server.py

# ── Robot ─────────────────────────────────────────────────────────────────────
# BOB V2: one ESP32-S3 board — robot + camera on the same IP.
# Find the IP on the TFT at boot, or use the mDNS name http://anvyxo-robo.local
# The firmware always boots AP "Anvyxo_robo" / "bob12345" at 192.168.4.1
# and joins home WiFi if credentials are saved. Use the home WiFi IP here.
ROBOT_HOST=192.168.1.12

# ── Camera (BOB V2 — built into ESP32-S3, no separate ESP32-CAM board) ────────
# The OV2640 is now part of the main firmware. Snapshots come from:
#   GET http://<ROBOT_HOST>/cam/snapshot
# CAM_HOST is no longer used by robo_robot.py; kept here for reference only.
# CAM_HOST=192.168.1.12

# Minimum confidence (0-1) to trust a hand-gesture classification
GESTURE_MIN_SCORE=0.4
# Degrees to rotate the camera frame before gesture recognition (in the Python worker).
# 180 = camera mounted upside-down (default for this build). Use 0 if right-side-up.
CAM_ROTATE=180

# ── RPS snapshot quality ──────────────────────────────────────────────────────
# BOB V2: resolution and quality are fixed in firmware (QVGA, quality 12).
# These vars are kept for documentation but are no longer sent to the robot.
# CAM_FRAMESIZE=8   (was: OV2640 framesize enum — 8=VGA, now firmware-fixed)
# CAM_QUALITY=12    (was: JPEG quality 10-63 — now firmware-fixed)
# CAM_FLASH=1       (was: flash LED on capture — not wired on this build)

# ── TTS ───────────────────────────────────────────────────────────────────────
TTS_VOICE=Samantha
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Sample rate sent to the ESP32 I2S speaker (MAX98357A).
# Firmware reads this from the WAV header. Lower = smaller file = faster upload.
# 16000 Hz is the native rate for Whisper STT; 11025 Hz cuts bytes by ~30%.
# Run tests/test_audio_quality.py to find the best rate for your WiFi link.
TTS_RATE=16000

# Loudness for the small 4 W / 2 Ω speaker. Kept GENTLE: the tiny low-impedance
# cone buzzes/distorts when speech is slammed to full scale, even though the
# firmware sine tone test sounds fine. If Bob is too quiet, raise TTS_GAIN_DB a
# couple dB at a time before touching TTS_PEAK. If it buzzes/distorts, lower
# TTS_PEAK or raise TTS_HIGHPASS_HZ.
TTS_GAIN_DB=0
TTS_PEAK=0.8
# Final attenuation after the limiter. A 2026-10-11 level sweep found the amp/
# speaker output stage only plays clean at peak ~0.06; higher peaks distort on
# loud syllables regardless of compression. 0.067 scales the limited waveform
# to that clean peak (clean but faint). Used only when TTS_SOFTCLIP_DRIVE=0.
# Independent of TTS_GAIN_DB (pre-limiter).
TTS_OUTPUT_GAIN=0.067
# Loudness + de-harsh chain (overrides TTS_OUTPUT_GAIN when drive>0). Pipeline:
# limiter -> tanh soft-clip (drive) -> low-pass (TTS_POST_LOWPASS_HZ) -> peak
# normalize (TTS_OUTPUT_PEAK). The low-pass strips the harsh high-freq harmonics
# the soft-clip adds (sibilant hiss) and raises the clean peak ceiling from
# ~0.06 (full band) to ~0.10. Live-validated 2026-10-11: peak 0.10 is loud and
# clear on all sentences; 0.15 distorts. drive=0 disables the chain (plain
# TTS_OUTPUT_GAIN); TTS_POST_LOWPASS_HZ=0 soft-clips without the low-pass.
TTS_SOFTCLIP_DRIVE=2.0
TTS_POST_LOWPASS_HZ=4500
TTS_OUTPUT_PEAK=0.10
# Dual compressor (TTS_COMPRESS=1) raises perceived loudness without clipping.
# Set 0 to fall back to TTS_SPEECHNORM_E expansion instead.
TTS_COMPRESS=1
# speechnorm expansion — used only when TTS_COMPRESS=0. Lower = gentler.
TTS_SPEECHNORM_E=0
# High-pass cutoff (Hz) — drops sub-bass the little speaker can't reproduce and
# that causes cone buzz. Set 0 to disable.
# Run tests/test_audio_quality.py — Test 4 to find optimal value for your speaker.
TTS_HIGHPASS_HZ=180

# Chunking: split long replies into ≤ TTS_CHUNK_CHARS characters per upload.
# Smaller = first audio arrives sooner (lower latency) but more round-trips.
# TTS_FIRST_CHUNK_CHARS: smaller opening chunk reduces buffer-before-play delay.
# Run tests/test_tts_pipeline.py to find the best values.
TTS_CHUNK_CHARS=90
TTS_FIRST_CHUNK_CHARS=60

# Set to 1 to also play TTS on Mac speaker (useful without the robot)
TTS_PLAY_LOCALLY=0

# ── TTS playback mode ─────────────────────────────────────────────────────────
# TTS_MODE selects how audio is played on the ESP32 speaker:
#
#   buffer  (default) — POST /mactts
#     Firmware buffers the entire WAV into PSRAM before playing.
#     Pros: jitter-free playback (immune to WiFi hiccups mid-upload).
#     Cons: audio starts only AFTER the full upload completes.
#     Best for: shaky WiFi, long sentences, guaranteed quality.
#
#   stream — POST /streamplay
#     Firmware feeds PCM bytes directly to I2S DMA as they arrive.
#     No PSRAM used at all. Audio starts within the first 1-2 TCP segments.
#     Pros: much lower first-sound latency (~100ms vs ~500ms).
#     Cons: WiFi hiccup mid-upload → audible click/pop. Use with a strong
#           2.4 GHz link and a router the robot is close to.
#     Best for: low-latency conversation on a solid WiFi link.
#
# TTS_ENDPOINT overrides the endpoint used; leave blank to auto-derive from TTS_MODE.
TTS_MODE=buffer
# Async buffered TTS server; use the robot's current IP.
# For stream mode, use the main HTTP server (port 80) instead.
TTS_BASE_URL=http://192.168.1.15:8080
# TTS_ENDPOINT=mactts

# ── Display sync ──────────────────────────────────────────────────────────────
# DISPLAY_DELAY_MS: delay (ms) inserted before firing /eyes + /ticker + /screen/*
# so the screen update arrives just as the speaker starts, not 300-1500ms before.
# 0 = current "screen first" behaviour (text visible while TTS is still rendering).
# Run tests/test_latency.py to find the recommended value for your setup.
DISPLAY_DELAY_MS=0

# ── Whisper STT ───────────────────────────────────────────────────────────────
# distil-small.en — ~200-350ms, best speed/quality for real-time conversation
WHISPER_MODEL=distil-small.en

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── Watsonx (Db2z outside-help + Ollama fallback) ────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://us-south.ml.cloud.ibm.com
# Model used for Stage-1 fallback (when Ollama is down)
LLM_MODEL=meta-llama/llama-3-3-70b-instruct
# Model used for Stage-2 IBM Db2z expert answers (defaults to LLM_MODEL if blank)
OUTSIDE_MODEL=meta-llama/llama-3-3-70b-instruct
PROJECT_ID=

# ── Mic capture / VAD ─────────────────────────────────────────────────────────
# Default input; can be switched live at http://localhost:8090.
# robot = SPH0645 via /record (fixed 1–3 second windows); mac = local silence detection.
MIC_SOURCE=robot
ROBOT_RECORD_SECS=3
# The current ESP32-S3 profile disables IMU/lift detection. Enable only with matching firmware.
ROBOT_IMU_ENABLED=1
# Gain applied to speech before upload (dB). Start at 0 to avoid heavy distortion.
TTS_GAIN_DB=0

# Mac mic only: max seconds to listen per turn (recording stops sooner if silence detected)
LISTEN_DURATION=10
# How many ms of silence after speech ends the recording (default 800)
SILENCE_AFTER_SPEECH_MS=800
# Minimum ms of speech before silence can trigger stop (default 300)
MIN_SPEECH_MS=300

# VAD threshold — leave both blank for auto-calibration (recommended).
# Auto-cal samples 1s of ambient noise at startup and sets threshold = floor × MULT.
# If the mic never triggers, lower MULT. If it triggers on background noise, raise it.
VAD_THRESHOLD_MULT=3.0
# How many seconds of silence to sample during auto-calibration (default 1.0)
VAD_CAL_SECS=1.0
# Override: set a fixed RMS threshold and skip auto-calibration entirely.
# Check the peak_rms line in the vad log to find a good value for your mic.
# Leave blank (or delete the line) to use auto-calibration.
VAD_ENERGY_THRESHOLD=
# avfoundation device — ":0" = default Mac mic, ":1" = second input etc.
MIC_DEVICE=:0

# ── Server ────────────────────────────────────────────────────────────────────
ROBO_CONVO_PORT=8090

# ── Idle mode ─────────────────────────────────────────────────────────────────
# How often (seconds) the idle watcher polls /state to detect scared/shake
IDLE_POLL_SECS=2
# Random idle animation: while idling, Bob plays a random built-in move so he
# feels alive. Set to 0 to disable (idle then only watches for shake/pick-up).
IDLE_ANIM_ENABLED=1
# Seconds between idle moves (random gap from end of one move to start of next).
# Kept short so Bob does a small fidget every few seconds. Only small/gentle
# moves are used in idle; big/showy moves are reserved for conversation mode.
IDLE_ANIM_MIN_GAP=2
IDLE_ANIM_MAX_GAP=6

# ── Wake word (idle mode) ─────────────────────────────────────────────────────
# In idle mode Bob keeps listening (short mic windows → Whisper) and jumps into
# conversation mode the moment he hears his name. Set WAKE_WORD_ENABLED=0 to
# make idle mode passive (no listening).
WAKE_WORD_ENABLED=1
# Comma-separated phrases that wake Bob. Matched on word boundaries, case- and
# punctuation-insensitive, so "Hey, Bob!" and "bob?" both trigger.
WAKE_WORDS=hey anvyxo,anvyxo,hi anvyxo,ok anvyxo,hey bob,bob,hi bob,ok bob
# Length (seconds) of each wake-word listen window (robot mic caps this at 3 s).
WAKE_LISTEN_SECS=3
# Per-mode mic: wake-word listening uses the robot's SPH0645 mic; conversation
# uses the Mac mic so it gets fast VAD (stops as soon as you finish speaking).
WAKE_MIC_SOURCE=robot
CONVO_MIC_SOURCE=mac

# ── Convo mode ────────────────────────────────────────────────────────────────
CONVO_MAX_TURNS=20

# ── Mock robot (offline testing without hardware) ─────────────────────────────
# Run:  .venv/bin/python static_robo.py  (starts on port 8092)
# Then: set ROBOT_HOST=localhost:8092 and restart server.py
# Or:   press "Start mock robot" in the dashboard right-panel.
# The mock plays received TTS audio through the Mac speaker via afplay.
MOCK_ROBO_PORT=8092
# Set to 0 to suppress afplay playback in the mock (receive but ignore audio)
# MOCK_PLAY_AUDIO=1

# ── Benchmark / testing ───────────────────────────────────────────────────────
# Comma-separated Ollama model tags to benchmark (blank = auto-detect from running Ollama)
# BENCH_OLLAMA_MODELS=qwen2.5:3b,qwen2.5:7b,llama3.2:3b
# Comma-separated Watsonx model IDs to benchmark
# BENCH_WATSONX_MODELS=meta-llama/llama-3-3-70b-instruct,meta-llama/llama-3-2-3b-instruct
