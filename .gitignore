# =============================================================
#  BOB ESP32-S3 Robot — .gitignore
#  Keep secrets, build artefacts, large binaries and local
#  machine-specific files out of the repository.
# =============================================================

# ── Secrets & credentials ─────────────────────────────────────
# .env holds WatsonX API keys, robot IP, LLM credentials.
# NEVER commit — use .env.example as the template.
.env
.env.local
.env.*.local
*.env

# ── Python virtual environments ───────────────────────────────
.venv/
.venv-gesture/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Arduino / ESP32 build outputs ─────────────────────────────
# Compiled binaries — regenerated by ota_flash.sh / arduino-cli
/tmp/bob-ota-build/
/tmp/bob-s3-motion-build/
*.ino.bin
*.ino.elf
*.ino.map
*.ino.partitions.bin
*.ino.bootloader.bin
bootloader.bin
partitions.bin

# ── Test results & recorded audio ─────────────────────────────
# WAV/log files produced by TTS quality tests — large, local only
BOB_ROBO_CONVO/tests/results/
*.wav
*.aiff
*.mp3
*.mp4

# ── Photo captures (robot camera snapshots) ───────────────────
*.jpg
*.jpeg
# Keep PNG previews in BOB_V2/preview/ — exclude everything else
BOB_ROBO_CONVO/screen_captures/

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── macOS metadata ────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V8
.Trashes
.AppleDouble
.LSOverride
Icon?

# ── Editor / IDE ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# ── Bob AI assistant internal state ───────────────────────────
.bob/

# ── Node (if any web tooling is added later) ──────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Misc temp files ───────────────────────────────────────────
*.tmp
*.bak
*.orig
*.rej
.cache/
